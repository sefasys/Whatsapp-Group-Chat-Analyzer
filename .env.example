# LLM Provider Configuration: "claude" | "gemini" | "groq"
LLM_PROVIDER=gemini

# Core API Infrastructure credentials (Only fill your target provider)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Algorithmic Slicing Variables
CHUNK_SIZE=400
CHUNK_OVERLAP=50
MIN_MESSAGES=20
MAX_SAMPLE=100

# Local Guardrails
ANONYMIZE_NAMES=true
STORE_RAW_MESSAGES=false
